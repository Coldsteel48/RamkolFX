# Maintainer: Roman Levin (Coldsteel48) <noreply@github.com>
pkgname=ramkolfx
# _semver / pkgver are maintained by packaging/version.sh from ../../VERSION.
_semver=0.2.1
pkgver=0.2.1
pkgrel=0
pkgdesc="3D spatial audio, EQ and bass enhancer for PipeWire"
url="https://github.com/Coldsteel48/RamkolFX"
arch="x86_64 aarch64"
license="GPL-3.0-only"
depends="pipewire onnxruntime"
makedepends="cmake samurai pipewire-dev sdl2-dev fontconfig-dev dbus-dev libx11-dev mesa-dev zlib-dev linux-headers"
options="!check"
builddir="$srcdir/RamkolFX-$_semver"
source="RamkolFX-$_semver.tar.gz::$url/archive/v$_semver.tar.gz
	libmysofa-1.3.5.tar.gz::https://github.com/hoene/libmysofa/archive/refs/tags/v1.3.5.tar.gz
	kissfft-131.2.0.tar.gz::https://github.com/mborgerding/kissfft/archive/refs/tags/131.2.0.tar.gz
	imgui-1.91.6.tar.gz::https://github.com/ocornut/imgui/archive/refs/tags/v1.91.6.tar.gz
	"

build() {
	cmake -S . -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DRAMKOLFX_HRTF_DATA_DIR=/usr/share/ramkolfx/hrtf \
		-DRAMKOLFX_MODEL_DATA_DIR=/usr/share/ramkolfx/models \
		-DRAMKOLFX_BUILD_GUI=ON \
		-DRAMKOLFX_BUILD_TESTS=OFF \
		$(sh packaging/ci/vendor-flags.sh "$srcdir")
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build --component ramkolfx
}

# Run `abuild checksum` once the v$_semver tag exists to fill these in.
