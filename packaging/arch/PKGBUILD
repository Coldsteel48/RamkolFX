# Maintainer: Roman Levin (Coldsteel48)
pkgname=ramkolfx
# _semver / pkgver are maintained by packaging/version.sh from ../../VERSION.
_semver=0.2.0
pkgver=0.2.0
pkgrel=1
pkgdesc='3D spatial audio (HRTF binaural / ambisonics), EQ and bass enhancer for PipeWire'
arch=('x86_64' 'aarch64')
url='https://github.com/Coldsteel48/RamkolFX'
license=('GPL-3.0-only')
depends=('pipewire' 'sdl2' 'fontconfig' 'zlib' 'libgl' 'dbus')
optdepends=('onnxruntime-cpu: Auto-detect (content-aware EQ presets)')
makedepends=('cmake' 'ninja' 'libx11')
options=('!debug')
source=("RamkolFX-$_semver.tar.gz::$url/archive/v$_semver.tar.gz"
        'libmysofa-1.3.5.tar.gz::https://github.com/hoene/libmysofa/archive/refs/tags/v1.3.5.tar.gz'
        'kissfft-131.2.0.tar.gz::https://github.com/mborgerding/kissfft/archive/refs/tags/131.2.0.tar.gz'
        'imgui-1.91.6.tar.gz::https://github.com/ocornut/imgui/archive/refs/tags/v1.91.6.tar.gz')
sha256sums=('SKIP' # replaced by `updpkgsums` once the v$_semver tag exists
            'f29508c335c83d8703f943ffc9ca783ac39aca84e851357f13a55af0f8143137'
            '205a8f6a448ef12b091f8ac6a514b5091bb5f6b0b543431ed75f673116cf5cbf'
            'c5fbc5dcab1d46064001c3b84d7a88812985cde7e0e9ced03f5677bec1ba502a')

build() {
  cmake -S "RamkolFX-$_semver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DRAMKOLFX_HRTF_DATA_DIR=/usr/share/ramkolfx/hrtf \
    -DRAMKOLFX_MODEL_DATA_DIR=/usr/share/ramkolfx/models \
    -DRAMKOLFX_BUILD_GUI=ON \
    -DRAMKOLFX_BUILD_TESTS=OFF \
    $(sh "RamkolFX-$_semver/packaging/ci/vendor-flags.sh" "$srcdir")
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build --component ramkolfx
}
